rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------- Helpers ---------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEventManager() {
      return hasRole('event_manager') || isAdmin();
    }

    function isSubscriber() {
      return hasRole('subscriber') || hasRole('member') || isEventManager();
    }

    function isSameTeam(teamId) {
      return isSignedIn() && getUserData().teamId == teamId;
    }

    // --------- Global Events (shared catalog) ---------
    match /events/{eventId} {
      allow read: if isSignedIn();
      // Only admins and event managers can create/edit/delete global events
      allow create, update, delete: if isEventManager();
    }

    // --------- Users ---------
    match /users/{userId} {
      // Users can read their own doc; admins can read all
      allow read: if isOwner(userId) || isAdmin();
      // Users can update their own profile; admins can update any
      allow update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow delete: if isAdmin();

      // -- Personal per-event prize stats --
      match /eventStats/{eventId} {
        // Only the owner can read/write their own event stats
        allow read, write: if isOwner(userId);
      }
    }

    // --------- Team Event Data (private performance stats) ---------
    match /team_event_data/{teamId}/events/{eventId} {
      // Team members can read stats for their own team
      allow read: if isSameTeam(teamId) || isAdmin();
      // Members can write their own team's stats
      allow write: if isSameTeam(teamId) || isAdmin();
    }

    // --------- Team Join Requests ---------
    match /team_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.teamId == request.auth.uid ||
         isAdmin());
      // Any signed-in user can create a request (for themselves)
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the team leader (teamId == uid) or admin can update/delete
      allow update, delete: if isSignedIn() &&
        (resource.data.teamId == request.auth.uid || isAdmin());
    }

    // --------- Team Messages ---------
    match /team_messages/{messageId} {
      allow read: if isSignedIn() && isSameTeam(resource.data.teamId);
      allow create: if isSignedIn() && isSameTeam(request.resource.data.teamId)
                       && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --------- Payment Requests ---------
    match /payment_requests/{requestId} {
      // User can read their own; admin/event_manager can read all
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isEventManager());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only admins can approve/reject payments
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}